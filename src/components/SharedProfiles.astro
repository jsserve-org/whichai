---
import Base from "../layouts/Base.astro";
---
<Base title="分享的 AI 檔案">
    <main class="page">
        <header class="page-head">
            <h1 class="page-title">分享的 AI 檔案</h1>
            <a href="/" class="text-button">回到首頁</a>
        </header>
        <p id="shared-status" class="empty" hidden></p>
    </main>
    <script>
        import { convexCall, shareEnabled } from "../lib/convex";
        import type { Profile } from "../lib/rows";

        // Share links look like /s/<id>; ?id=<id> is still accepted.
        const slug = location.pathname.match(/^\/s\/([^/]+)\/?$/)?.[1] ?? new URLSearchParams(location.search).get("id");
        const local = slug && shareEnabled ? JSON.parse(localStorage.getItem(`whichai-share-${slug}`) ?? "null") : null;
        // A link opened in another browser isn't in localStorage, so fall back to Convex.
        const stored = local ?? (slug ? (await convexCall("query", "profiles:get", { slug }).catch(() => null))?.value ?? null : null);

        if (stored) {
            // Opening a share link applies it to this browser, then the home page shows the result.
            const shared: Profile[] = Array.isArray(stored) ? stored : (stored.profiles ?? []);
            const own = JSON.parse(localStorage.getItem("whichai-profiles") ?? "[]") as Profile[];
            localStorage.setItem("whichai-profiles", JSON.stringify([...own, ...shared.filter((profile) => !own.some((p) => p.id === profile.id))]));
            if (stored.geminiUserId) localStorage.setItem("gemini-userId", stored.geminiUserId);
            if (typeof stored.tempChat === "boolean") localStorage.setItem("chatgpt-tempChat", String(stored.tempChat));
            if (Array.isArray(stored.disabledDefaults)) localStorage.setItem("whichai-disabled-defaults", JSON.stringify(stored.disabledDefaults));
            location.replace("/");
        } else {
            const status = document.querySelector<HTMLParagraphElement>("#shared-status");
            if (status) { status.textContent = slug && !shareEnabled ? "分享功能已關閉。" : slug ? "找不到這個分享檔案。" : "找不到這個頁面。"; status.hidden = false; }
            if (!slug) { const title = document.querySelector(".page-title"); if (title) title.textContent = "找不到頁面"; }
        }
    </script>
</Base>
